# Directories this service may expose, comma separated. Optional "Label=" prefix.
# Users can only ever be granted folders inside these roots.
MEDIA_ROOTS=Movies=/media/movies,Music=/media/music
# Root admin, created on first start if that username doesn't exist yet
ROOT_USERNAME=admin
ROOT_PASSWORD=change-me-too
PORT=3000
SQLITE_PATH=data.sqlite
# true when served over HTTPS / behind a reverse proxy
COOKIE_SECURE=false
TRUST_PROXY=false
# ffmpeg/ffprobe enable track listing, embedded subtitles, audio-track switching and compatibility playback
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# max simultaneous ffmpeg jobs
MAX_FFMPEG=3
# Interface to listen on (0.0.0.0 = reachable from the LAN). Use 127.0.0.1 for local-only.
HOST=0.0.0.0
# Optional: secret that signs shared links (default: generated once, stored in the database). Changing it invalidates all links.
LINK_SECRET=
